    {
      "type": "inline",
      "dest-filename": "install.sh",
      "contents": "#!/bin/bash\n# Copyright 2023 The Chromium Authors\n# Use of this source code is governed by a BSD-style license that can be\n# found in the LICENSE file.\n\nset -e # Exit immediately if a command exits with a non-zero status.\nset -x # Print commands and their arguments as they are executed.\nset -o pipefail\n\nPREFIX=\"$1\"\n\n./configure --prefix=\"${PREFIX}\"\nmake install -j$(nproc)\n\n# Add README.chromium file to the package after substituting the version with\n# $_3PP_VERSION.\nTHIS_DIR=$(dirname \"$0\")\nsed 's/$_3PP_VERSION/'\"$_3PP_VERSION\"'/' \\\n\"$THIS_DIR/README.chromium\" > \"$PREFIX/README.chromium\"\n\n# Copy the license file into the package.\ncp \"COPYING\" \"$PREFIX\"\n",
      "dest": "gperf-src/3pp",
      "only-arches": [
        "aarch64"
      ]
    },
    {
      "type": "inline",
      "dest-filename": "README.chromium",
      "contents": "Name: GNU perf\nShort Name: gperf\nURL: https://ftp.gnu.org/gnu/gperf\nVersion: $_3PP_VERSION\nRevision: DEPS\nUpdate Mechanism: Manual\nLicense: GPL-3.0\nLicense File: COPYING\nShipped: no\nSecurity Critical: no\n\nDescription:\nGNU 'gperf' generates perfect hash functions.\n\nLocal Modifications:\nAdded README.chromium metadata file.\n",
      "dest": "gperf-src/3pp",
      "only-arches": [
        "aarch64"
